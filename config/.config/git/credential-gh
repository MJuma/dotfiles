#!/bin/sh
# Git credential helper: uses the gh account named in the remote URL (https://<user>@github.com/...),
# so every account logged in to gh works without `gh auth switch`. Other URLs use gh's active account.
[ "$1" = get ] || exit 0

# GUI apps can run git with a minimal PATH
PATH=$PATH:/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin

input=$(cat)
user=$(printf '%s\n' "$input" | sed -n 's/^username=//p')

if [ -z "$user" ]; then
    printf '%s\n' "$input" | gh auth git-credential get
    exit
fi

token=$(gh auth token --user "$user" 2>/dev/null) || exit 0
printf 'username=%s\npassword=%s\n' "$user" "$token"
