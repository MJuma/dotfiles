# Tools these dotfiles use on macOS. setup.sh installs them; to run it alone: brew bundle --file=~/dotfiles/Brewfile
brew "stow"                 # setup.sh
brew "git-lfs"              # .gitconfig requires the lfs filter
brew "git-delta"            # Git pager
brew "fzf"
brew "ripgrep"              # fzf file list, fif
brew "fd"                   # fzf Ctrl+T, Alt+C and ** completion
brew "bat"                  # previews, cat alias
brew "tmux"
brew "code-minimap"         # minimap.vim
cask "font-hack-nerd-font"  # powerline glyphs in tmux, lightline and the pwsh prompt
